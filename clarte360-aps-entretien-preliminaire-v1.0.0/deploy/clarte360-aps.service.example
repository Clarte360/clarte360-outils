[Unit]
Description=Clarte360 APS Streamlit
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/clarte360/clarte360-outils/clarte360-aps-entretien-preliminaire
ExecStart=/opt/clarte360/clarte360-outils/clarte360-aps-entretien-preliminaire/.venv/bin/streamlit run app.py --server.address 127.0.0.1 --server.port 8502 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
