[Unit]
Description=Clarte360 Boussole des valeurs
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/clarte360/clarte360-outils/boussole_valeurs_pro
ExecStart=/opt/clarte360/clarte360-outils/boussole_valeurs_pro/.venv/bin/streamlit run app.py --server.address 127.0.0.1 --server.port 8505 --server.headless true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
