# Include inside the existing HTTPS server block for Gestion des Actions.
# Keep the bridge bound to loopback; only Nginx handles TLS and public traffic.
location /api/cp/ {
    client_max_body_size 34m;
    proxy_read_timeout 30s;
    proxy_connect_timeout 3s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_pass http://127.0.0.1:8765/api/cp/;
}

location = /api/cp/healthz {
    proxy_set_header Host $host;
    proxy_pass http://127.0.0.1:8765/healthz;
}
