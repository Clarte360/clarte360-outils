[Unit]
Description=Clarte360 Emargements Email Worker
After=network.target clarte360-emargements.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/clarte360/clarte360-outils/clarte360-emargements-v1.0.0
ExecStart=/opt/clarte360/clarte360-outils/clarte360-emargements-v1.0.0/.venv/bin/python worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
